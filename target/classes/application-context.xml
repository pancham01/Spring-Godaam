<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->

	<bean name="emp1" class="com.my.spring.model.Employee" autowire="byType" scope="singleton">
		<property name="id" value="101" />
		<property name="name" value="Vikas" />
		<property name="gender" value="male" />
	</bean>


	
	<bean name="adds" class="com.my.spring.model.Address">
		<constructor-arg name="city" value="GZB" />
		<constructor-arg name="state" value="UP" />
	</bean>

</beans>